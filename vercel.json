{
  "framework": "vite",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "outputDirectory": "dist",
  "routes": [
    { "handle": "filesystem" },
    { "src": "^/api/(.*)$", "dest": "/api/$1" },
    {
      "src": "^/demo/([A-Za-z0-9-]+)/?$",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|LinkedInBot|Twitterbot|Slackbot|Slack-ImgProxy|Discordbot|TelegramBot|WhatsApp|SkypeUriPreview|redditbot|Embedly|Pinterest|vkShare|Mastodon|Bluesky|Iframely).*"
        }
      ],
      "dest": "/api/demo_preview?id=$1"
    },
    {
      "src": "^/map/?$",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|LinkedInBot|Twitterbot|Slackbot|Slack-ImgProxy|Discordbot|TelegramBot|WhatsApp|SkypeUriPreview|redditbot|Embedly|Pinterest|vkShare|Mastodon|Bluesky|Iframely).*" }],
      "dest": "/api/demo_preview?page=map"
    },
    { "src": "^/(?!api/|@|src/|node_modules/).*$", "dest": "/index.html" }
  ]
}
